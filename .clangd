CompileFlags:
  CompilationDatabase: out/build/clang-debug
  Compiler: /opt/homebrew/opt/llvm/bin/clang++
  Add:
    - -std=c++23
    - -ferror-limit=0
    # Warnings: enable all, treat as errors (including deprecated)
    - -Wall
    - -Werror
    - -Weverything
    - -Werror=deprecated
    - -Wpedantic
    # C++23 project: ignore C++98 compatibility (included in -Weverything)
    - -Wno-c++98-compat
    - -Wno-c++98-compat-pedantic
    # from_chars requires raw pointer arithmetic; the stdlib API cannot be changed
    - -Wno-unsafe-buffer-usage
    # Use Homebrew LLVM libc++
    - -nostdinc++
    - -isystem
    - /opt/homebrew/opt/llvm/include/c++/v1
    # # GMP headers
    # - -isystem
    # - /opt/homebrew/include

    # macOS SDK system headers (IMPORTANT when using -nostdinc++)
    # - -isystem
    # - /Library/Developer/CommandLineTools/SDKs/MacOSX.sdk/usr/include

    # Project headers
    - -I/Users/laksh/Documents/PersonalCode/cc-cut-tool/include

    # Boost headers
    - -isystem
    - /opt/homebrew/opt/boost/include